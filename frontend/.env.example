# ============================================
# Pet Daylight Frontend - Environment Variables
# ============================================
# 이 파일을 .env.production으로 복사하고 실제 값을 입력하세요

# API URL (백엔드)
REACT_APP_API_URL=https://api.petdaylight.com/api

# 카카오맵 API Key (필요시)
REACT_APP_KAKAO_MAP_KEY=your-kakao-map-key

# Google Analytics (필요시)
REACT_APP_GA_TRACKING_ID=UA-XXXXXXXXX-X
